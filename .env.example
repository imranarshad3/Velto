# Copy to .env (git-ignored) for local development. Never commit real values.
# Production values are set in Vercel → Project → Settings → Environment Variables.

# --- Browser (bundled into client JS; public values only) ---
# Clerk publishable key (pk_test_... / pk_live_...). Leave empty to run the store guest-only.
VITE_CLERK_PUBLISHABLE_KEY=
# Optional Cloudflare Turnstile site key; set together with TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=

# --- Server only (Vite dev API middleware / Vercel Functions). NEVER prefix these with VITE_. ---
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase secret key (sb_secret_...) or legacy service_role key. Bypasses RLS: server use only.
SUPABASE_SECRET_KEY=
# Clerk secret key (sk_test_... / sk_live_...): verifies session tokens server-side.
CLERK_SECRET_KEY=
# Optional networkless verification: PEM public key from the Clerk dashboard (API keys → JWT public key).
CLERK_JWT_KEY=
# Comma-separated frontend origins accepted as the token's azp claim.
# Local: http://localhost:5173   Production: https://<your-domain>
CLERK_AUTHORIZED_PARTIES=
# Comma-separated origins allowed to call /api from a browser (same values as above).
ALLOWED_ORIGINS=
# >= 32 random characters; keys guest tracking-code and rate-limit hashes. Generate: `openssl rand -base64 48`.
# Rotating it invalidates existing guest tracking codes.
QUOTE_HASH_SECRET=
TURNSTILE_SECRET_KEY=

# --- Tooling only (not read by the app) ---
# Postgres connection string for applying supabase/migrations with psql. Contains the DB password.
SUPABASE_DB_URL=

# --- Local development only (ignored on Vercel/production) ---
# In-memory store when Supabase is not configured.
QUOTE_DEV_MEMORY_STORE=
# Fake `dev:<id>` sign-in for testing account/admin UIs without Clerk; both must be 1.
VITE_DEV_FAKE_AUTH=
NOVARO_DEV_FAKE_AUTH=
